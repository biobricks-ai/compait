  "dcterms:title": "CoMPAIT (Collaborative Modeling Project for Acute Inhalation Toxicity) dataset",
  "dcterms:description": "CoMPAIT is a harmonized dataset of acute inhalation toxicity studies released by the NICEATM CoMPAIT consortium. It contains curated LC50 data (mg/L and ppm), exposure phase (gas, vapor, aerosol), chemical identifiers (SMILES, DTXSID, CASRN) and hazard categories across multiple regulatory frameworks (GHS, EPA OPPT, EPA OPP, CPSC, DoT), supplied as a training set (LC50_Tr) and an evaluation/prediction set. Source: NICEATM CoMPAIT Consortium (https://ntp.niehs.nih.gov/go/iccvam).",
  "dcterms:license": "https://creativecommons.org/licenses/by/4.0/",
  "biobricks:licenseName": "CC BY 4.0",
  "biobricks:licenseClass": "attribution",
  "biobricks:merckCommercialUse": "permitted",
